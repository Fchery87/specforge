# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# GitHub OAuth (server-only, optional until you connect a repository)
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Convex deployment variables. Convex functions do not read these from .env.local.
# Set them on each Convex deployment with `npx convex env set NAME`.
# Clerk JWT Issuer Domain (required for Convex auth)
# Get this from Clerk Dashboard > Configure > JWT Templates > Convex
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-issuer.clerk.accounts.dev

# Convex
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_ENCRYPTION_KEY=your-32-byte-hex-key
